<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Colors: 무채색 회색 + 탁한 청회색 포인트 -->
    <Color x:Key="BackgroundColor">#1C1C1C</Color>
    <Color x:Key="SurfaceColor">#242424</Color>
    <Color x:Key="SurfaceAltColor">#2D2D2D</Color>
    <Color x:Key="BorderColor">#404040</Color>
    <Color x:Key="ForegroundColor">#D0D0D0</Color>
    <Color x:Key="ForegroundMutedColor">#8C8C8C</Color>
    <Color x:Key="AccentColor">#6A97B5</Color>
    <Color x:Key="AccentHoverColor">#85AFC9</Color>
    <Color x:Key="ErrorColor">#E0705F</Color>
    <Color x:Key="WarnColor">#D19A52</Color>
    <Color x:Key="InfoColor">#6A97B5</Color>
    <Color x:Key="DebugColor">#8AA66B</Color>
    <Color x:Key="RowAltColor">#282828</Color>
    <Color x:Key="SelectionColor">#334A5A</Color>
    <Color x:Key="HoverColor">#2C3840</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
    <SolidColorBrush x:Key="ForegroundMutedBrush" Color="{StaticResource ForegroundMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="DebugBrush" Color="{StaticResource DebugColor}"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="{StaticResource RowAltColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>

</ResourceDictionary>
