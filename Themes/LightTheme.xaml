<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Colors: 윈도우 기본 회색 계열 + 탁한 청회색 포인트 -->
    <Color x:Key="BackgroundColor">#F0F0F0</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#E4E4E4</Color>
    <Color x:Key="BorderColor">#BFBFBF</Color>
    <Color x:Key="ForegroundColor">#1A1A1A</Color>
    <Color x:Key="ForegroundMutedColor">#6B6B6B</Color>
    <Color x:Key="AccentColor">#3E6E8E</Color>
    <Color x:Key="AccentHoverColor">#315872</Color>
    <Color x:Key="ErrorColor">#B83227</Color>
    <Color x:Key="WarnColor">#A8650A</Color>
    <Color x:Key="InfoColor">#3E6E8E</Color>
    <Color x:Key="DebugColor">#4A7A35</Color>
    <Color x:Key="RowAltColor">#F7F7F7</Color>
    <Color x:Key="SelectionColor">#CDDDE8</Color>
    <Color x:Key="HoverColor">#E9EEF1</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
    <SolidColorBrush x:Key="ForegroundMutedBrush" Color="{StaticResource ForegroundMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="DebugBrush" Color="{StaticResource DebugColor}"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="{StaticResource RowAltColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>

</ResourceDictionary>
