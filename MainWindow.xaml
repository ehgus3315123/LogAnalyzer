<Window x:Class="LogViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LogViewer"
        Title="Log Viewer" Height="860" Width="1280" MinWidth="900" MinHeight="600"
        Icon="pack://application:,,,/App.ico"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True"
        PreviewDragOver="MainWindow_PreviewDragOver"
        DragLeave="MainWindow_DragLeave"
        Drop="MainWindow_Drop">

    <Window.Resources>
        <local:LevelToBrushConverter x:Key="LevelToBrush"/>
        <local:LevelToBackgroundConverter x:Key="LevelToBg"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <local:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis"/>
        <local:NullToVisibilityConverter x:Key="NullToVis"/>
        <local:IntGreaterThanZeroToVisibilityConverter x:Key="IntGtZeroToVis"/>
        <local:DoubleToPercentStringConverter x:Key="DoubleToPercent"/>
        <local:PercentToWidthConverter x:Key="PercentToWidth"/>
        <local:DragOverBrushConverter x:Key="DragOverBrush"/>
        <local:PathToFileNameConverter x:Key="PathToFileName"/>

        <!-- Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Source filter chip: on = accent fill, off = muted outline -->
        <Style x:Key="SourceChipToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DatePicker Style -->
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <!-- ListView / GridView style -->
        <Style x:Key="LogListView" TargetType="ListView">
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False"/>
        </Style>

        <Style x:Key="LogListViewItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0" SnapsToDevicePixels="True">
                            <GridViewRowPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Columns="{Binding Path=View.Columns,
                                    RelativeSource={RelativeSource AncestorType=ListView}}"
                                Content="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GridViewColumnHeader style -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Card Border Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>

        </Style>

    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding}" CommandParameter="FocusSearch"
                    x:Name="FocusSearchBinding"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ErrorOnlyCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshFilesCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.OpenLogSearchCommand}"/>
    </Window.InputBindings>

    <Grid>
        <!-- Startup: open file -->
        <Border Background="{DynamicResource BackgroundBrush}"
                Visibility="{Binding IsStartupScreenVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <!-- Main card -->
                <Border Style="{StaticResource Card}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="20"
                        Width="720"
                        MaxWidth="720">
                    <StackPanel>
                        <TextBlock Text="로그 파일 불러오기" FontSize="24" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,16">
                            <Run Text="파일을 선택하거나 .log / .txt 파일을 이 창에 드래그하세요."/>
                        </TextBlock>

                        <Button Content="파일 선택..."
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16"
                                Command="{Binding OpenFileCommand}"/>

                        <!-- Drag hint strip -->
                        <Border CornerRadius="3" Padding="16,14" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <!-- valid drop -->
                                        <DataTrigger Binding="{Binding IsDragOverValid}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Background" Value="#140D47A1"/>
                                        </DataTrigger>
                                        <!-- invalid drop (IsDragOver=true, IsDragOverValid=false) -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsDragOver}" Value="True"/>
                                                <Condition Binding="{Binding IsDragOverValid}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="Crimson"/>
                                            <Setter Property="Background" Value="#10DC143C"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <!-- State 1: not dragging -->
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text=".log / .txt 파일을 이 창에 드래그하면 바로 분석을 시작합니다"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- State 2: valid drop -->
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDragOverValid}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="파일을 놓으면 분석을 시작합니다"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- State 3: invalid drop -->
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsDragOver}" Value="True"/>
                                                        <Condition Binding="{Binding IsDragOverValid}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text=".log 또는 .txt 파일 1개만 드롭할 수 있습니다"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="Crimson" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Recent files panel -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                                Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="목록 지우기"
                                            Style="{StaticResource SecondaryButton}" Padding="10,3"
                                            Command="{Binding ClearRecentFilesCommand}"/>
                                    <TextBlock Text="최근 열었던 파일" Style="{StaticResource SectionHeader}"
                                               Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding RecentFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenRecentFileCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand" HorizontalContentAlignment="Stretch">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent"
                                                                CornerRadius="2" Padding="10,6" Margin="0,0,0,2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FilePath, Converter={StaticResource PathToFileName}}"
                                                                               FontWeight="SemiBold" FontSize="13"
                                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding FilePath}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding LastOpened, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background"
                                                                        Value="{DynamicResource SurfaceAltBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Full-window drag overlay (appears on top when dragging over startup screen) -->
                <Border x:Name="DragOverlay"
                        Visibility="{Binding IsDragOver, Converter={StaticResource BoolToVis}}"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDragOverValid}" Value="True">
                                    <Setter Property="Background" Value="#0F0D47A1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <!-- Animated border ring -->
                    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            BorderThickness="3" CornerRadius="0" Margin="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Crimson"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDragOverValid}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <Grid Visibility="{Binding IsStartupScreenVisible, Converter={StaticResource InvBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Toolbar -->
                <RowDefinition Height="*"/>     <!-- Main Content -->
                <RowDefinition Height="Auto"/>  <!-- Status Bar -->
            </Grid.RowDefinitions>

        <!-- ══ TOOLBAR ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title + load buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Log Viewer" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <Button Content="처음으로" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetToStartupCommand}" Margin="0,0,8,0"
                            ToolTip="파일 선택 화면으로 돌아가기"/>
                    <Button Content="새로고침 (F5)" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshFilesCommand}" Margin="0,0,8,0"
                            ToolTip="현재 불러온 파일을 다시 읽습니다"/>
                    <Button Content="로그 검색 (Ctrl+Shift+F)" Style="{StaticResource SecondaryButton}"
                            Click="OpenSearch_Click"
                            ToolTip="로드된 전체 로그에서 찾기 (제외 조건과 무관)"/>
                    <!-- Loaded file count badge -->
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"
                            Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding LoadedFiles.Count, Converter={StaticResource IntGtZeroToVis}}">
                        <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                            <Run Text="{Binding LoadedFiles.Count, Mode=OneWay}"/>
                            <Run Text="개 파일"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Right: Theme toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleDarkModeCommand}" Padding="10,6">
                        <Grid>
                            <TextBlock Text="다크 모드" HorizontalAlignment="Center"
                                       Visibility="{Binding IsDarkMode, Converter={StaticResource InvBoolToVis}}"/>
                            <TextBlock Text="라이트 모드" HorizontalAlignment="Center"
                                       Visibility="{Binding IsDarkMode, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ MAIN CONTENT ═════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="12,10,12,8">

            <!-- ── Log list ──────────────────────────────────────────── -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>    <!-- Log list -->
                    <RowDefinition Height="Auto"/> <!-- Detail pane -->
                </Grid.RowDefinitions>

                <!-- Log list -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- List header bar -->
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="12,7" CornerRadius="3,3,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="로그 목록" FontWeight="Bold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"
                                                Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="White">
                                                <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                                                <Run Text="건"/>
                                            </TextBlock>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding LoadedFiles}" Margin="10,0,0,0"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Mode=OneWay}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <!-- 글자 크기 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="컬럼 ▾" Click="ColumnsButton_Click" Style="{StaticResource SecondaryButton}"
                                                Padding="8,1" Margin="0,0,10,0" ToolTip="표시할 컬럼 선택"/>
                                        <Button Content="A−" Click="FontSmaller_Click" Style="{StaticResource SecondaryButton}"
                                                Padding="8,1" ToolTip="글자 작게 (Ctrl+휠)"/>
                                        <Button x:Name="FontScaleButton" Content="100%" Click="FontReset_Click"
                                                Style="{StaticResource SecondaryButton}" Padding="6,1" Margin="4,0"
                                                MinWidth="48" ToolTip="클릭하면 100%로 되돌립니다"/>
                                        <Button Content="A+" Click="FontLarger_Click" Style="{StaticResource SecondaryButton}"
                                                Padding="8,1" ToolTip="글자 크게 (Ctrl+휠)"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 키워드 입력 + 추가 버튼 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 포함 칩 + 입력 -->
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="포함 필터" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding FilterChips}"
                                                      Visibility="{Binding FilterChips.Count, Converter={StaticResource IntGtZeroToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="3" Margin="0,0,4,4" Padding="8,2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Keyword}"
                                                                       Foreground="White" FontSize="11"
                                                                       VerticalAlignment="Center"/>
                                                            <Button Content="×"
                                                                    Command="{Binding RemoveCommand}"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="White" FontSize="13"
                                                                    Padding="4,0,0,0" Cursor="Hand"
                                                                    VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="+"
                                                    Command="{Binding AddFilterChipCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="10,3" Margin="6,0,0,0" FontSize="14" FontWeight="Bold"
                                                    ToolTip="키워드를 필터 칩으로 추가 (Enter)"/>
                                            <TextBox x:Name="FilterChipSearchBox"
                                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SearchBox}"
                                                     Tag="포함"
                                                     ToolTip="메시지 또는 소스에 포함된 항목만 표시. Enter 또는 + 버튼으로 칩 추가"
                                                     KeyDown="FilterChipSearchBox_KeyDown"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- 제외 칩 + 입력 -->
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="제외 필터" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding ExcludeChips}"
                                                      Visibility="{Binding ExcludeChips.Count, Converter={StaticResource IntGtZeroToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ErrorBrush}"
                                                            CornerRadius="3" Margin="0,0,4,4" Padding="8,2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Keyword}"
                                                                       Foreground="White" FontSize="11"
                                                                       VerticalAlignment="Center"/>
                                                            <Button Content="×"
                                                                    Command="{Binding RemoveCommand}"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="White" FontSize="13"
                                                                    Padding="4,0,0,0" Cursor="Hand"
                                                                    VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="+"
                                                    Command="{Binding AddExcludeChipCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="10,3" Margin="6,0,0,0" FontSize="14" FontWeight="Bold"
                                                    ToolTip="제외 키워드를 칩으로 추가 (Enter)"/>
                                            <TextBox x:Name="ExcludeChipSearchBox"
                                                     Text="{Binding ExcludeKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SearchBox}"
                                                     Tag="제외"
                                                     ToolTip="입력한 문자열이 포함된 메시지는 목록에서 숨깁니다. Enter 또는 + 버튼으로 칩 추가"
                                                     KeyDown="ExcludeChipSearchBox_KeyDown"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 소스 필터: 켜진 칩만 목록에 표시 -->
                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding HasSourceFilters, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="소스" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               Margin="0,0,0,4"/>
                                    <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding SourceFilters}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Style="{StaticResource SourceChipToggle}"
                                                                  IsChecked="{Binding IsIncluded}"
                                                                  Content="{Binding DisplayText}"
                                                                  ToolTip="클릭하여 소스 표시/숨김"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Loading overlay -->
                        <Grid Grid.Row="1">
                            <ListView x:Name="LogListView"
                                      Style="{StaticResource LogListView}"
                                      ItemContainerStyle="{StaticResource LogListViewItem}"
                                      ItemsSource="{Binding FilteredEntries}"
                                      SelectedItem="{Binding SelectedEntry}"
                                      SelectionMode="Extended"
                                      PreviewMouseWheel="LogListView_PreviewMouseWheel"
                                      BorderThickness="0,0,0,0">
                                <ListView.LayoutTransform>
                                    <ScaleTransform x:Name="ListScale"/>
                                </ListView.LayoutTransform>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="전체 복사" Click="CopyAll_Click"/>
                                        <MenuItem Header="메시지만 복사" Click="CopyMessage_Click"/>
                                        <Separator/>
                                        <MenuItem Header="메모장으로 보기" Click="ViewInNotepad_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="#" Width="55">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding LineNumber, Mode=OneTime}"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                                               FontSize="11" Padding="4,3"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="시각" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TimeDisplay, Mode=OneTime}"
                                                               ToolTip="{Binding TimestampDisplay, Mode=OneTime}"
                                                               FontFamily="맑은 고딕" FontSize="12" Padding="4,3"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="레벨" Width="66">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="3" Margin="2"
                                                            Background="{Binding LevelDisplay, Mode=OneTime, Converter={StaticResource LevelToBg}}"
                                                            Padding="5,2">
                                                        <TextBlock Text="{Binding LevelDisplay}"
                                                                   Foreground="{Binding LevelDisplay, Mode=OneTime, Converter={StaticResource LevelToBrush}}"
                                                                   FontWeight="Bold" FontSize="11"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="소스" Width="70">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Source, Mode=OneTime}"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="11" Padding="4,3"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="메시지" Width="550">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MessageDisplay, Mode=OneTime}"
                                                               FontFamily="맑은 고딕" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" Padding="4,3"
                                                               ToolTip="{Binding RawLine, Mode=OneTime}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="스택 트레이스" Width="500">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CallStackDisplay, Mode=OneTime}"
                                                               FontFamily="맑은 고딕" FontSize="11"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" Padding="4,3"
                                                               ToolTip="{Binding CallStack, Mode=OneTime}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <!-- Empty state -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding EmptyMessage}"
                                           FontSize="15" Foreground="{DynamicResource ForegroundMutedBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                        </Grid>
                    </Grid>
                </Border>

                <!-- Detail pane for selected entry -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0"
                        MaxHeight="120"
                        Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}">
                            
                            <Run Text="{Binding SelectedEntry.TimestampDisplay, Mode=OneWay}"/>
                            <Run Text="  "/>
                            <Run Text="{Binding SelectedEntry.LevelDisplay, Mode=OneWay}"
                                 Foreground="{DynamicResource ErrorBrush}"/>
                            <Run Text="  "/>
                            <Run Text="{Binding SelectedEntry.Source, Mode=OneWay}"/>
                        </TextBlock>
                        <StackPanel Grid.Row="1">
                            <TextBox Text="{Binding SelectedEntry.Message, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     FontFamily="맑은 고딕" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedEntry.CallStack, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource ForegroundMutedBrush}"
                                     FontFamily="맑은 고딕" FontSize="11"
                                     Visibility="{Binding SelectedEntry.CallStack, Converter={StaticResource StrNotEmptyToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ══ STATUS BAR ════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,5">
            <Grid>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="12"/>
                <TextBlock HorizontalAlignment="Right"
                           Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="12">
                    <Run Text="전체 "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text=" 줄"/>
                </TextBlock>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
