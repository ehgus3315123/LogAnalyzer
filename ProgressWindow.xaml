<Window x:Class="LogViewer.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="작업 중"
        Height="140" Width="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/App.ico"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageText" Grid.Row="0"
                   Text="작업 중..." TextWrapping="Wrap"
                   Foreground="{DynamicResource ForegroundBrush}"/>
        <ProgressBar x:Name="Bar" Grid.Row="2" Height="8"
                     Minimum="0" Maximum="100" IsIndeterminate="True"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="{DynamicResource SurfaceAltBrush}"/>
        <TextBlock x:Name="PercentText" Grid.Row="3" Margin="0,8,0,0"
                   HorizontalAlignment="Right" FontSize="11"
                   Foreground="{DynamicResource ForegroundMutedBrush}"
                   Visibility="Collapsed"/>
    </Grid>
</Window>
